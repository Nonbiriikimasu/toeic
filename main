  <title>TOEIC AI Test Generator (Part 4/5/6/7)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen py-10 px-4">

  <div class="max-w-3xl mx-auto space-y-6">

    <!-- ヘッダー -->
    <header class="text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">TOEIC AI Quiz Generator</h1>
      <p class="text-sm text-slate-500 mt-2">Gemini API を使って TOEIC Part 5 / 6 / 7 の問題を自動生成</p>
    </header>

    <!-- 1. APIキー設定カード -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h2 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
        <span>🔑</span> 1. Gemini APIキーの設定
      </h2>
      <p class="text-xs text-slate-500 mb-3">
        キーをお持ちでない方は 
        <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline font-medium hover:text-indigo-800">
          Google AI Studio (aistudio.google.com)
        </a> 
        から無料で発行できます。
      </p>
      <div class="flex gap-2">
        <input type="password" id="apiKeyInput" placeholder="APIキーを入力（AIzaSy...）" class="flex-1 px-4 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <button onclick="saveApiKey()" class="px-4 py-2 bg-slate-800 text-white text-sm font-medium rounded-lg hover:bg-slate-700 transition">
          保存
        </button>
      </div>
      <p id="apiKeyStatus" class="text-xs mt-2 font-medium hidden"></p>
    </div>

    <!-- 2. 問題生成条件設定 -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span>⚙️</span> 2. 条件を選択して生成
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <!-- Part 選択 -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-2">セクション (Part)</label>
          <select id="partSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
            <option value="5">Part 5 (短文穴埋め問題 - 1問)</option>
            <option value="6">Part 6 (長文穴埋め問題 - 4設問)</option>
            <option value="7">Part 7 (長文読解問題 - 3設問)</option>
          </select>
        </div>

        <!-- 難易度 選択 -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-2">ターゲット難易度</label>
          <select id="levelSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
            <option value="600点レベル">600点レベル（基礎〜標準）</option>
            <option value="730点レベル" selected>730点レベル（中級）</option>
            <option value="860点レベル">860点レベル（応用・高難易度）</option>
            <option value="990点レベル">990点レベル（最高難易度・ひっかけ含む）</option>
          </select>
        </div>
      </div>

      <button id="generateBtn" onclick="generateQuiz()" class="w-full py-3 bg-indigo-600 text-white font-bold rounded-lg shadow hover:bg-indigo-700 transition flex items-center justify-center gap-2">
        <span>✨</span> 問題を生成する
      </button>
    </div>

    <!-- ローディング表示 -->
    <div id="loading" class="hidden text-center py-10 bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent mb-3"></div>
      <p class="text-sm font-medium text-slate-600">AIが問題を自動作成中...（数秒かかります）</p>
    </div>

    <!-- 3. 問題表示・解答エリア -->
    <div id="quizContainer" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-6">
      
      <div class="flex justify-between items-center border-b pb-4">
        <span id="quizBadge" class="px-3 py-1 bg-indigo-100 text-indigo-800 text-xs font-bold rounded-full">Part 5</span>
        <span id="quizLevelBadge" class="text-xs text-slate-500 font-medium">730点レベル</span>
      </div>

      <!-- Part 6/7の本文表示エリア -->
      <div id="passageArea" class="hidden p-4 bg-slate-50 rounded-lg border border-slate-200">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Passage / 本文</h3>
        <p id="passageText" class="text-slate-800 text-sm leading-relaxed whitespace-pre-wrap font-serif"></p>
      </div>

      <!-- 設問一覧 -->
      <div id="questionsList" class="space-y-8"></div>

      <!-- 採点ボタン -->
      <div class="border-t pt-6">
        <button id="submitBtn" onclick="gradeQuiz()" class="w-full py-3 bg-emerald-600 text-white font-bold rounded-lg shadow hover:bg-emerald-700 transition">
          採点する
        </button>
      </div>

      <!-- 結果・解説表示エリア -->
      <div id="resultArea" class="hidden space-y-6 pt-4 border-t">
        <div id="scoreBanner" class="p-4 text-center rounded-lg font-bold text-lg"></div>

        <!-- 本文の和訳（Part 6/7） -->
        <div id="translationArea" class="hidden p-4 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-900">
          <h4 class="font-bold mb-1 text-amber-800">📄 全文和訳 / 本文訳</h4>
          <p id="passageTranslation" class="whitespace-pre-wrap leading-relaxed"></p>
        </div>
      </div>

    </div>

  </div>

  <script>
    let currentQuizData = null;
    let selectedAnswers = {};

    // 画面ロード時に保存済みAPIキーを取得
    window.onload = function() {
      const savedKey = localStorage.getItem('gemini_api_key');
      if (savedKey) {
        document.getElementById('apiKeyInput').value = savedKey;
        showKeyStatus('保存済みのAPIキーが設定されています', 'emerald');
      }
    };

    function saveApiKey() {
      const key = document.getElementById('apiKeyInput').value.trim();
      if (!key) {
        alert('APIキーを入力してください');
        return;
      }
      localStorage.setItem('gemini_api_key', key);
      showKeyStatus('APIキーを保存しました！', 'emerald');
    }

    function showKeyStatus(msg, color) {
      const el = document.getElementById('apiKeyStatus');
      el.innerText = msg;
      el.className = `text-xs mt-2 font-medium text-${color}-600 block`;
    }

    async function generateQuiz() {
      const apiKey = localStorage.getItem('gemini_api_key');
      if (!apiKey) {
        alert('先にGemini APIキーを入力して保存してください。');
        return;
      }

      const part = document.getElementById('partSelect').value;
      const level = document.getElementById('levelSelect').value;

      // UI初期化
      document.getElementById('loading').classList.remove('hidden');
      document.getElementById('quizContainer').classList.add('hidden');
      document.getElementById('resultArea').classList.add('hidden');
      selectedAnswers = {};

      const prompt = `TOEIC L&R テストの Part ${part} の問題を1セット生成してください。ターゲット難易度: ${level}。
Part 5なら単文穴埋め1問、Part 6なら長文穴埋め本文＋設問4問、Part 7なら読解長文本文＋設問3問を作成してください。
ビジネスシーンでよく使われる自然な英単語と表現、文法構造を取り入れてください。`;

      // Structured Outputs (JSON Schema) 定義
      const jsonSchema = {
        type: "OBJECT",
        properties: {
          part: { type: "INTEGER" },
          passage: { type: "STRING", description: "Part 6/7の本文。Part 5の場合は空文字" },
          passageTranslation: { type: "STRING", description: "本文の和訳（Part 5の場合は問題文の和訳）" },
          questions: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                id: { type: "INTEGER" },
                questionText: { type: "STRING", description: "設問文。Part 5やPart 6の場合は空欄____付きの文" },
                options: {
                  type: "OBJECT",
                  properties: {
                    A: { type: "STRING" },
                    B: { type: "STRING" },
                    C: { type: "STRING" },
                    D: { type: "STRING" }
                  },
                  required: ["A", "B", "C", "D"]
                },
                correctAnswer: { type: "STRING", enum: ["A", "B", "C", "D"] },
                explanation: { type: "STRING", description: "正解の根拠、解法、重要語彙・文法解説" }
              },
              required: ["id", "questionText", "options", "correctAnswer", "explanation"]
            }
          }
        },
        required: ["part", "passage", "passageTranslation", "questions"]
      };

      try {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }],
            systemInstruction: { parts: [{ text: "あなたはTOEICテスト作成のプロフェッショナルです。厳密に指定されたJSONスキーマに従って出力してください。" }] },
            generationConfig: {
              responseMimeType: "application/json",
              responseSchema: jsonSchema
            }
          })
        });

        const data = await res.json();
        if (data.error) throw new Error(data.error.message);

        const text = data.candidates[0].content.parts[0].text;
        currentQuizData = JSON.parse(text);

        renderQuiz(currentQuizData, level);

      } catch (err) {
        alert('生成エラー: ' + err.message);
      } finally {
        document.getElementById('loading').classList.add('hidden');
      }
    }

    function renderQuiz(quiz, level) {
      document.getElementById('quizBadge').innerText = `Part ${quiz.part}`;
      document.getElementById('quizLevelBadge').innerText = level;

      // Passage (本文) 表示の制御
      const passageArea = document.getElementById('passageArea');
      if (quiz.passage && quiz.passage.trim() !== "") {
        document.getElementById('passageText').innerText = quiz.passage;
        passageArea.classList.remove('hidden');
      } else {
        passageArea.classList.add('hidden');
      }

      // 設問一覧の作成
      const listEl = document.getElementById('questionsList');
      listEl.innerHTML = '';

      quiz.questions.forEach((q, idx) => {
        const qBox = document.createElement('div');
        qBox.className = 'space-y-3';
        
        let qTitle = `<p class="font-bold text-slate-900 text-sm">${idx + 1}. ${escapeHtml(q.questionText)}</p>`;
        
        let optionsHtml = '<div class="grid grid-cols-1 gap-2 mt-2">';
        ['A', 'B', 'C', 'D'].forEach(opt => {
          optionsHtml += `
            <button type="button" 
                    id="btn-${q.id}-${opt}" 
                    onclick="selectOption(${q.id}, '${opt}')"
                    class="opt-btn-${q.id} w-full text-left px-4 py-2.5 text-sm rounded-lg border border-slate-200 hover:bg-slate-50 transition flex items-center gap-3">
              <span class="font-bold text-slate-500 w-5">${opt}.</span>
              <span class="text-slate-800">${escapeHtml(q.options[opt])}</span>
            </button>
          `;
        });
        optionsHtml += '</div>';

        // 個別解説領域 (初期非表示)
        const expHtml = `
          <div id="exp-${q.id}" class="hidden mt-3 p-3 bg-slate-50 rounded-lg text-xs text-slate-700 leading-relaxed border-l-4 border-indigo-500">
            <p class="font-bold text-indigo-900 mb-1">💡 解説 [正解: ${q.correctAnswer}]</p>
            <p>${escapeHtml(q.explanation)}</p>
          </div>
        `;

        qBox.innerHTML = qTitle + optionsHtml + expHtml;
        listEl.appendChild(qBox);
      });

      document.getElementById('quizContainer').classList.remove('hidden');
    }

    function selectOption(qId, option) {
      selectedAnswers[qId] = option;
      
      // ボタンの見た目を更新
      document.querySelectorAll(`.opt-btn-${qId}`).forEach(btn => {
        btn.classList.remove('border-indigo-600', 'bg-indigo-50', 'font-semibold');
        btn.classList.add('border-slate-200');
      });

      const selectedBtn = document.getElementById(`btn-${qId}-${option}`);
      selectedBtn.classList.remove('border-slate-200');
      selectedBtn.classList.add('border-indigo-600', 'bg-indigo-50', 'font-semibold');
    }

    function gradeQuiz() {
      let correctCount = 0;
      const total = currentQuizData.questions.length;

      currentQuizData.questions.forEach(q => {
        const userAns = selectedAnswers[q.id];
        const correctAns = q.correctAnswer;

        // 全選択肢のカラー判定を表示
        ['A', 'B', 'C', 'D'].forEach(opt => {
          const btn = document.getElementById(`btn-${q.id}-${opt}`);
          btn.disabled = true; // 採点後はクリック不可

          if (opt === correctAns) {
            btn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'font-bold');
          } else if (opt === userAns && userAns !== correctAns) {
            btn.classList.add('bg-rose-100', 'border-rose-500', 'text-rose-900');
          }
        });

        if (userAns === correctAns) {
          correctCount++;
        }

        // 個別解説を表示
        document.getElementById(`exp-${q.id}`).classList.remove('hidden');
      });

      // スコア表示
      const banner = document.getElementById('scoreBanner');
      banner.innerText = `結果: ${total}問中 ${correctCount}問 正解！ (${Math.round((correctCount/total)*100)}%)`;
      if (correctCount === total) {
        banner.className = 'p-4 text-center rounded-lg font-bold text-lg bg-emerald-100 text-emerald-800';
      } else {
        banner.className = 'p-4 text-center rounded-lg font-bold text-lg bg-amber-100 text-amber-800';
      }

      // 和訳エリア表示
      if (currentQuizData.passageTranslation) {
        document.getElementById('passageTranslation').innerText = currentQuizData.passageTranslation;
        document.getElementById('translationArea').classList.remove('hidden');
      }

      document.getElementById('resultArea').classList.remove('hidden');
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
